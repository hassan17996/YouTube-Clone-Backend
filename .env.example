# ---------- Server ----------
APP_PORT=3000

# ---------- PostgreSQL ----------
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ---------- JWT ----------
# Must be at least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- Email (OTP) ----------
# Mailtrap for development: https://mailtrap.io
# Gmail: smtp.gmail.com, port 587, use an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="YouTube Clone <no-reply@youtubeclone.local>"
